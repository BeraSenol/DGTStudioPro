%% DGT Studio Pro — 03 players and the registry
%% Authored 5 Aug 2026 against the tree at 75a02d3, read from source
%% (PlayersDestination, PGNStore.retag / refuseCollisions /
%%  collectOrphanedPlayers / playersOrphaned, PlayerStats, Glicko1).

flowchart TD

    P0(("Players destination")) --> P1["ONE query since D60′: PGN by importedAt.<br/>The second query over Player existed only so<br/>D40′'s sweep toolbar could count orphans<br/>reactively - with collection automatic this<br/>destination has no reason to know the<br/>registry exists"]

    subgraph FOLD["Pure folds D10′ - GameRecord in, no SwiftData imported"]
        P1 --> P2["games.map to GameRecord<br/>ordering contract: date or importedAt, then<br/>importedAt, then contentHash. A fold's output<br/>is only as deterministic as its order, so the<br/>chain down to a TOTAL tiebreak is the contract"]
        P2 --> P3["PlayerStats.index - emits only players<br/>holding at least one game"]
        P3 --> P4["Glicko1.histories - 1500 / RD 350,<br/>floor 30, cap 350, c = 0, one game per period,<br/>provisional while RD above 110.<br/>c = 0 means no wall-clock input: the rating<br/>is a PURE deterministic fold"]
        P4 --> P5["RankedPlayer - rank under D11′ plus the<br/>rating riding along"]
    end

    P3 -.-> INV
    INV["INVARIANT D40′: an orphaned player is unreachable<br/>through SELECTION, permanently and by<br/>construction. A record's sides come from RESOLVED<br/>links, so a linkless row is in no view mode.<br/>Anything gated on the SELECTED player having no<br/>games is dead code with a green build"]

    P5 --> SORT{"Sort order - set by clicking a LIST-MODE<br/>column header since 5 Aug 2026.<br/>Once ascending, twice descending"}
    SORT -->|"Rank, ascending - the default"| SORT1["IS the D11′ ladder: wins down, win rate down,<br/>key up. Not a reimplementation - rank was<br/>folded through PlayerStats.rankingOrder before<br/>any view saw the row, so ordering by the badge<br/>number reproduces the comparator exactly.<br/>That equivalence is what let D48′'s persisted<br/>rank/name picker be DELETED rather than kept<br/>beside this - two controls answering one<br/>question is the twin-read-site shape"]
    SORT -->|"Player, or any of the other seven"| SORT2["Rank STILL renders in every ordering, because<br/>rank is a fact about the player and not a<br/>position in the current sort - the half of<br/>D48′ that outlived its picker.<br/>Session-only, deliberately: a sort is the<br/>question being asked now, not a preference"]

    SORT1 --> SEARCH
    SORT2 --> SEARCH

    SEARCH["Search text plus rated-ness chips<br/>the SAME D30′ fold the Library uses"]
    SEARCH --> MODE{"View mode?<br/>the shared key again"}

    MODE -->|"list"| MD1["Table"]
    MODE -->|"columns"| MD2["Finder-flat: one-column list plus detail.<br/>FLAT, not grouped - the letter and win-band<br/>buckets went with the card grid they navigated<br/>in the 2 Aug redesign. Its single header sorts<br/>by name and shares the comparator above, so it<br/>READS any ordering and can only SET that one"]
    MODE -->|"icons"| MD3["Grid"]
    MODE -->|"gallery"| MD4["Filmstrip"]

    MD1 --> PAINTED
    MD2 --> PAINTED
    MD3 --> PAINTED
    MD4 --> PAINTED

    PAINTED["Rows painted"]
    PAINTED -->|"click, or rubber band"| SELECT
    PAINTED -->|"Cmd-A"| CMDA

    CMDA["The system's Edit, Select All - the same<br/>responder-chain mechanism as the Library,<br/>over the same narrowing"] --> SELECT

    SELECT{"How many selected?"}

    SELECT -->|"none"| NOSEL["No fallback, and never preview what the user<br/>did not pick - the Library's rule, which both<br/>galleries now share since 4 Aug 2026"]
    SELECT -->|"one"| PROFILE["ONE profile grid states each fact ONCE:<br/>Rank, Games, Record, Win Rate, Rating,<br/>Uncertainty, Rated Games, Mates, First and<br/>Last Played. Record's first component absorbed<br/>the old duplicate Wins row"]
    SELECT -->|"two"| SUB["Head-to-head line in the toolbar subtitle"]
    SELECT -->|"three or more - e.g. after Cmd-A"| SUBN["Count only. NO head-to-head line:<br/>that is a count-of-two state"]

    PROFILE --> TREND["Rating trend - ordinal, ONE monotone line.<br/>Game number is the rating's own clock because<br/>under c = 0 idle time changes nothing, so a<br/>date axis would spend its width on pauses.<br/>x pins at game 1; axis labels are de-localised,<br/>because a locale was writing 1512 as 1.512"]

    TREND --> ACT{"Action?"}
    NOSEL --> P0
    SUB --> ACT
    SUBN --> ACT

    ACT -->|"Get Info - Cmd-I"| RN0["The player form is the app's ONE rename door<br/>DRILL-DOWN: diagram 04"]
    ACT -->|"Show in Library"| SHOW["Filter the Library to this player"]

    SHOW --> DONE

    subgraph RENAME["Rename - D37′ / D39′ / D53′. Reached only from Get Info"]
        RN0 --> RN1["The edited field is TAG form, comma order,<br/>seeded from tagName or name D29′.<br/>Seeding from name would put a DISPLAY form in<br/>a field that stores a tag, and the first commit<br/>would write it into every game's White tag"]
        RN1 --> RN2["The derived display line updates live beneath<br/>it - D23′'s one-way rule turned from a<br/>constraint into the form's own explanation"]
        RN2 --> RN3{"Commit on Return"}
        RN3 -->|"empty"| RN4["Revert - never reaches the store door"]
        RN3 -->|"unchanged"| RN5["No-op. The store would accept it SILENTLY:<br/>re-resolve, recompute the same MD5, rewrite the<br/>same bytes. Nothing happened and everything was<br/>rewritten identically look the same from<br/>outside, which is why this is worth stopping"]
        RN3 -->|"changed"| RT0["PGNStore.retag"]
        RN4 --> RN2
        RN5 --> DONE
    end

    subgraph RETAG["retag - one transaction, pre-flight first"]
        RT0 --> RT1["Build a Rewrite PER GAME with BOTH seat flags,<br/>not per seat - a player can hold both sides of<br/>one row, and asked seat-wise the pre-flight<br/>computes two hashes and reaches neither"]
        RT1 --> RT2["Compute EVERY prospective hash through the<br/>field-taking twin, before a single field is<br/>written - so a refused retag is<br/>indistinguishable from one never attempted"]
        RT2 --> RT3{"Would any hash collide?"}
        RT3 -->|"with a row already in the Library"| RT4
        RT3 -->|"with another game in the SAME batch"| RT4
        RT3 -->|"with ITSELF - fold-equivalent"| RT6["Not a collision. Allowed"]
        RT3 -->|"no"| RT7
        RT4["REFUSED WHOLE. The alert names up to three<br/>pairs and says nothing was changed;<br/>the FIELD REVERTS to the stored tag.<br/>Blocking beats auto-deduping: a merge that<br/>silently destroys a game cannot be undone"]
        RT4 --> RN2
        RT6 --> RT7
        RT7["Rewrite the stored seat tags, re-resolve the<br/>links, and REHASH inside the same transaction -<br/>a retagged game whose hash lags is dedupe rot<br/>with a delay fuse"]
    end

    RT7 --> COST["ACCEPTED COST D37′: seat tags are inside the<br/>content hash, so every affected game's hash<br/>moves. An export taken AFTER a rename<br/>re-imports and dedupes; one taken BEFORE no<br/>longer will. Not a leak to engineer around -<br/>by the hash's own definition the players are<br/>part of what identifies the game"]
    COST --> COST2["ACCEPTED COST D53′: a rename performed while<br/>Players is open CLEARS the selection rather than<br/>following it. A separate window cannot reach a<br/>destination's selection. The row is one click<br/>away under the name you just typed"]
    COST2 --> DONE

    subgraph COLLECT["D60′ - orphans are collected automatically, unasked"]
        CO0["Every door that can STRAND a row collects it:<br/>applyEdit and retag after re-resolving and<br/>BEFORE their save, so the edit stays one<br/>transaction; backfillPlayerLinks AFTER its<br/>relink loop, which is what heals the backlog"] --> CO1{"Any row nothing points at?"}
        CO1 -->|"no"| CO2["Nothing to do - the common case"]
        CO1 -->|"yes"| CO3["Delete it. The PGN files are the source of<br/>truth: a Player exists to give a seat tag an<br/>identity, and a row no game references is<br/>describing nobody"]
    end

    %% Declared inside SWEEP above, so this edge is written AFTER the block:
    %% mermaid places a node where it is FIRST SEEN, and naming SW0 up in the
    %% action fan-out would render it outside the very box it entitles.
    ACT -->|"nothing to invoke - see the note"| CO0

    CO2 --> DONE
    CO3 --> DONE

    DONE(("Back to the destination"))

    CO0 -.-> CASCADE
    CASCADE["D50′'s game-deletion cascade is UNCHANGED and stays<br/>PROSPECTIVE - it computes strandees BEFORE the<br/>first delete, because nullify propagation cannot<br/>be relied on afterwards. That is the one trap the<br/>post-hoc collector would walk into.<br/><br/>D40′'s manual sweep is GONE: with collection<br/>automatic its menu item could never enable, and<br/>a disabled affordance whose guard cannot be true<br/>is the thing D40′ itself forbids"]

    %% ---- shared class vocabulary: identical block in all five files ----
    classDef act   fill:#e8eef7,stroke:#5b7fb0,color:#12243d
    classDef dec   fill:#fdf0d5,stroke:#c9a227,color:#3d2f04
    classDef bad   fill:#fbe4e4,stroke:#c0504d,color:#4a1210
    classDef note  fill:#efe6f7,stroke:#8064a2,color:#2c1b3d
    classDef drill fill:#e3f2e3,stroke:#4f8a4f,color:#123312
    classDef term  fill:#2f3640,stroke:#1b1f24,color:#ffffff

    class P1,P2,P3,P4,P5,SORT1,SORT2,SEARCH,MD1,MD2,MD3,MD4,PAINTED,CMDA,PROFILE,TREND,SUB,SUBN,NOSEL,SHOW,RN1,RN2,RN4,RN5,RT0,RT1,RT2,RT6,RT7,CO0,CO2 act
    class SORT,MODE,SELECT,ACT,RN3,RT3,CO1 dec
    class RT4,COST,COST2,CO3 bad
    class INV,CASCADE note
    class RN0 drill
    class P0,DONE term
