%% DGT Studio Pro — 04 scene routing and the auxiliary windows
%% Re-authored 9 Aug 2026 against the tree at 5f82de7 plus the comment-reduction
%% working tree, read from source
%% (DGTStudioProApp.body, GetInfoWindow, EvaluationGraphWindow,
%%  AnalysisDataWindow, AnalysisQueueStatusWindowView,
%%  CollectionViewOptionsWindow, FullScreenAuxiliary).
%% FLOW ONLY, deliberately. Settings, the sleep inhibitor, logging and the
%% cross-cutting registries are STRUCTURE, not activity — drawing flowchart
%% arrows over them produced a file that was 21 nodes with no in-edge. They
%% live as a table in DIAGRAMS.md instead.

flowchart TD

    CALL(("A view calls<br/>openWindow value")) --> ROUTE{"SwiftUI routes by the value's<br/>TYPE - not by a scene id,<br/>not by declaration order"}

    ROUTE -.-> TRAP
    TRAP["THE TRAP, and it is why THREE wrapper types<br/>exist. The main group is declared for<br/>PersistentIdentifier. A SECOND group over that<br/>same type makes EVERY existing call ambiguous -<br/>and ambiguous here means opening a game from the<br/>Library opens an INFO window instead.<br/>D46′ minted EvaluationGraphRequest, D53′<br/>GetInfoRequest, D73′ AnalysisDataRequest - a<br/>pattern, not a quirk. The two SINGLETON scenes<br/>below sidestep it entirely: exactly one queue<br/>and one panel, opened by ID, no wrapper to mint"]

    ROUTE -->|"PersistentIdentifier"| W1["WindowGroup - games.<br/>Native macOS window tabs: one group is what<br/>lets Library and Board tab together"]
    ROUTE -->|"EvaluationGraphRequest"| W2["WindowGroup - Evaluation, 720x420"]
    ROUTE -->|"AnalysisDataRequest"| W4["WindowGroup - Analysis Data, 460x520"]
    ROUTE -->|"GetInfoRequest"| W3["WindowGroup - Info, 460x520"]

    CALLID(("A view calls<br/>openWindow id")) --> WQ["Window - Analysis queue, 520x560"]
    CALLID --> WV["Window - View Options, 340x300"]

    W1 --> W1A["Nil value lands on Library,<br/>a value lands on Board showing that game"]
    W1A --> DEST["ContentView -> destinations<br/>DRILL-DOWN: diagrams 01, 02, 03"]

    W2 --> W2A["windowLevel floating - hovers IN FRONT of the<br/>game windows rather than stacking with them"]
    W3 --> W3A["Deliberately NOT floating, unlike the graph.<br/>The graph is READ while the board underneath is<br/>driven; Get Info is EDITED, so it takes focus,<br/>and a floating window that owns the keyboard<br/>while sitting over everything is the shape<br/>people file bugs about"]
    W4 --> W4A["NOT floating either - a table is CONSULTED,<br/>not glanced. Its own group, so two games' data<br/>windows tab with each other and never with<br/>the boards"]

    W1A -.-> AUX
    AUX["Every companion scene carries<br/>windowManagerRole associated - D80′: it JOINS a<br/>full-screen space rather than claiming one.<br/>SCENE-level, so the role is set BEFORE the<br/>window is placed - the deleted AppKit<br/>configurator wrote the behaviour after, and a<br/>window already given its own Space is not<br/>re-homed by a later write.<br/>The main group keeps the primary role"]

    subgraph GRAPH["D46′ - the enlarged evaluation graph"]
        W2A --> G1{"Game resolvable, and hasScoredPly?<br/>the ONE spelling D67′ - an all-nil<br/>array is the empty state, not a<br/>flat 50/50 curve"}
        G1 -->|"no"| G2["ONE empty state for BOTH causes - no analysis,<br/>or the game is gone. The remedy is identical,<br/>and splitting them would explain a deletion the<br/>reader performed"]
        G1 -->|"yes"| G3["EvaluationGraphContent owns the hover, so the<br/>pointer does not re-run the window body"]
        G3 --> G4["onContinuousHover - the question is WHERE the<br/>pointer is, which onHover's bare Bool cannot<br/>answer. The ended phase CLEARS the read-out:<br/>a stale ply left on screen describes nothing"]
        G4 --> G5["EvaluationGraphGeometry maps ply to x and back.<br/>TWO consumers pointing opposite ways - the view<br/>places, the window hit-tests - which is why it<br/>is extracted rather than open-coded twice"]
        G5 --> G6["EvaluationGraphReading - the evaluation label is<br/>EvaluationBarReading's VERBATIM, and the test<br/>asserts against that type rather than a literal,<br/>because a literal keeps passing while the two<br/>grammars diverge"]
    end

    G2 --> IDLE
    G6 --> IDLE

    subgraph DATA["D73′ - the analysis as data"]
        W4A --> D1{"Game resolvable, and hasScoredPly?"}
        D1 -->|"no"| D2["The graph window's fold: gone, or never<br/>analysed - one state, same remedy"]
        D1 -->|"yes"| D3["Every ply as a row: the move in display<br/>grammar, the evaluation in the bar's PINNED<br/>grammar, the win probability it projects, and<br/>the SWING against the ply before D77′ - the<br/>blunder signal, folded from data already stored.<br/>Nil across gaps: a book hole must not produce a<br/>delta against a ply nobody scored.<br/>Rows fold once per resolved game, never per<br/>render tick"]
        D3 --> D4["An unscored ply carries NIL and renders an<br/>em dash - never the bar's 0.0 fold. The bar<br/>must render something at every ply; this table<br/>is STORED TRUTH, and 0.0 for a ply the engine<br/>never scored would be a lie.<br/>Since 8 Aug this window is the ONLY teller of<br/>coverage - Get Info's Analysis section is gone"]
        D4 --> D5["Opened from the table-list glyph beside the<br/>magnifier in the Library inspector's Evaluation<br/>header - data before the magnifier, so the<br/>graph control keeps the position a reader's<br/>hand learned"]
    end

    D2 --> IDLE
    D5 --> IDLE

    subgraph QUEUE["6 Aug - the analysis queue's own window, replacing the toolbar popover"]
        WQ --> Q1["Header: Analyzing 3 of 18 - batchPosition is<br/>the ONE spelling of that numerator, shared with<br/>the toolbar item, which once disagreed by one"]
        Q1 --> Q2["Two clocks in one line, spelled differently on<br/>purpose: elapsed is a MEASUREMENT, formatted to<br/>the second; remaining is a GUESS - about 9 min -<br/>projected from the observed rate in PLIES, not<br/>games, because games are wildly non-uniform.<br/>TimelineView derives the tick: a per-second<br/>write to an Observable would re-render every<br/>observer in the app"]
        Q2 --> Q3["The live search: the move in chess notation -<br/>a bare ply ordinal reads as a full-move number -<br/>the TARGET depth, not the climbing iteration,<br/>the evaluation through the bar's grammar,<br/>and meganodes per second"]
        Q3 --> Q4["The line, in run order, per-row removal, NO cap -<br/>and 92 more was a popover's apology for being<br/>a popover. The finished log NEWEST FIRST,<br/>cancelled deliberately not a warning colour:<br/>reporting the user's own choice back as a<br/>problem teaches people to ignore warnings"]
        Q4 --> Q5["Footer pinned below the scroll - Stop All must<br/>be reachable without scrolling past a hundred<br/>rows. Clear acknowledges a failed drain and<br/>hides the Library's toolbar item; the window<br/>STAYS OPEN - closing itself on a button press<br/>is the popover behaviour this view left behind"]
    end

    Q5 --> IDLE

    subgraph VIEWOPT["D69′ - View Options, Finder's Cmd-J"]
        WV --> V1["A pure READER of options.activeSubject.<br/>The panel must not read focus itself: opening<br/>it makes it key, so by first render its own<br/>FocusedValue is already nil. The collection<br/>destinations LATCH the subject in - only<br/>non-nil writes land, so focus moving to the<br/>panel keeps the last collection"]
        V1 --> V2{"A subject latched?"}
        V2 -->|"no - a cold restore with no<br/>collection ever in front"| V3["Named empty state rather than a bare Form,<br/>which reads as a broken window"]
        V2 -->|"yes"| V4["Sort: field picker per destination - two enums,<br/>two branches, a shared picker buys nothing -<br/>plus direction as WORDS: descending reads<br/>correctly for dates, counts, ratings and names<br/>where an arrow glyph says nothing.<br/>The same value the table headers set - one<br/>sort, two doors, persisted D69′"]
        V4 --> V5{"Icons mode in front?"}
        V5 -->|"yes"| V6["Icon size and grid spacing sliders - defaults<br/>land ON a tick, because Use Defaults moves the<br/>thumb and a thumb between ticks reads as a<br/>failed snap. The glyph is a FRACTION of the<br/>card, not a second slider"]
        V5 -->|"no"| V7["No grid section, with the sentence saying why -<br/>list and columns are tables, the gallery strip<br/>sizes itself to the card"]
    end

    V3 --> IDLE
    V6 --> IDLE
    V7 --> IDLE

    subgraph GETINFO["D53′ / D57′ / D59′ - Get Info: one group, three subjects"]
        W3A --> GI1{"Which subject?"}
        GI1 -->|"game - a PersistentIdentifier"| GI2["Resolve from the store, guarding tombstones"]
        GI1 -->|"live - carries NOTHING"| GI3["Resolve from the SESSION"]
        GI1 -->|"player - a normalized key"| GI4["Resolve from the registry"]

        GI3 -.-> GI3N
        GI3N["The asymmetry is load-bearing. A live game is not<br/>in the store and has no identifier until it<br/>archives, so this is an ENUM rather than a struct<br/>with an optional id - an optional would make<br/>no game and the live game the same value.<br/>It observes session.liveGame rather than resting<br/>on task id: a live request never CHANGES, so<br/>without that the window would keep rendering a<br/>retained game under Recording long after it<br/>archived"]

        GI2 --> GT{"Tab? THREE since D59′ -<br/>ordered by authorship"}
        GT -->|"Details - what you WROTE"| GD["The NINE tags export puts on disk D24′:<br/>the Seven Tag Roster D22′, then Board, then<br/>TimeControl. EDITABLE, per field, on Return or<br/>focus loss, through PGNStore.applyEdit.<br/>Every unknown DISPLAYS as one em dash D55′,<br/>while tagValue for export keeps the PGN<br/>vocabulary untouched - two switches, on purpose"]
        GT -->|"Move Text - what you PLAYED"| GM["D18′'s editor, moved here from the Library<br/>inspector's pencil D59′ - which had it for one<br/>day D54′, and the Board before that.<br/>Seeds as a numbered two-column SCORE SHEET -<br/>the numbers are decoration the tokenizer strips,<br/>so the validator never sees them.<br/>GAME FORM ONLY: a live game has no stored<br/>movetext and Decision 1 forbids the concept,<br/>so the tab is ABSENT rather than disabled"]
        GT -->|"File - what the app DERIVED"| GF["The ordinal D58′, import stamp WITH a time -<br/>two imports minutes apart are what it tells<br/>apart - the content hash, selectable, the seats<br/>as RESOLVED links - the one place tag versus<br/>link is visible - and the classification.<br/>READ-ONLY throughout. The Analysis section is<br/>GONE since 8 Aug: coverage's only teller is<br/>the data window D73′"]

        GM --> GMV{"Every ply legal, and the result<br/>consistent where claimable?"}
        GMV -->|"no"| GMR["REJECTED WHOLE, naming the first illegal ply,<br/>its SAN and why - and painting that ply RED in<br/>the field D79′: the range comes from the<br/>tokenizer's own grammar, so highlight and<br/>validator cannot disagree. A pasted two-game<br/>splice is refused by the tokenizer. Save stays<br/>disabled. A rejection on OPEN, before any edit,<br/>is the STORED moves' first-ever replay - import<br/>never runs one, diagram 02 - so it reports the<br/>file, not the editor. The ply number is 1-based<br/>over PLIES, not full moves: Move 98 is<br/>Black's 49th"]
        GMV -->|"yes"| GMS["Save: canonical SAN stored, hash refreshed,<br/>stored evaluations invalidated, RE-CLASSIFIED.<br/>No player re-resolution - a movetext edit<br/>cannot touch seats"]
        GMR --> GM

        GM -.-> GMN
        GMN["TWO COMMIT MODELS in one window, on purpose.<br/>Details commits PER FIELD, because each of the<br/>nine tags is independently valid. Movetext is<br/>accept-whole-or-reject-whole D18′, so it takes an<br/>explicit Save gated on the validator.<br/>Cancel became REVERT: a tab cannot close, so the<br/>button had to stop meaning dismiss.<br/>Save is NOT the default action - Return in a<br/>TextEditor is how you add a move"]

        GD -.-> GSEAT
        GSEAT["The White and Black rows carry a known-player<br/>MENU D59′ - the third surface to get one, after<br/>New Game D16′ and the archive sheet.<br/>All three insert tagName ?? name D29′ and label<br/>each item with the string they INSERT.<br/>Free text always works: the menu only fills, and<br/>picking creates nothing - resolvePlayer stays the<br/>single creation door.<br/>Here alone the menu also COMMITS, because this<br/>form has no Save for a filled field to wait for"]

        GD --> GDV{"Guards before the door"}
        GDV -->|"unchanged"| GDV1["Return BEFORE applyEdit - it would re-resolve,<br/>recompute the same MD5 and rewrite the same<br/>bytes, silently"]
        GDV -->|"empty Event or Site"| GDV2["REVERT - D24′ prints all nine tags always and an<br/>unknown is a question mark, so empty string is<br/>the one value that exports as neither a name<br/>nor an unknown"]
        GDV -->|"seat names the OTHER seat's player"| GDV5["REFUSED D61′ - identities, not strings:<br/>Lopez comma Ruy IS Ruy Lopez under the fold,<br/>which is the failure that looks most like the<br/>guard working. The field reverts and the alert<br/>names the player. Two unknowns never collide -<br/>they are two absences. IMPORT still admits<br/>self-play: the Decision 3 asymmetry"]
        GDV -->|"empty seat"| GDV3["Clears to unknown, which resolvePlayer reads as<br/>NO player - so clearing unlinks rather than<br/>minting a player named question mark"]
        GDV -->|"valid"| GDV4["applyEdit: re-resolve both seats, refresh the<br/>hash, COLLECT the player the re-spelling<br/>stranded D60′, one transaction"]

        GD -.-> GDN
        GDN["Native controls are a CORRECTNESS argument before<br/>an aesthetic one: a Picker over GameResult cannot<br/>produce a result outside the enum, and a<br/>DatePicker cannot produce February 31st. That<br/>deletes a class of validation rather than<br/>performing it, leaving exactly one rule no widget<br/>can know - whether the final position agrees with<br/>the result - and that one IS checked"]

        GI4 --> GP["The app's ONE rename door<br/>DRILL-DOWN: diagram 03"]
    end

    GMS --> IDLE
    GDV1 --> IDLE
    GDV2 --> GD
    GDV5 --> GD
    GDV3 --> GDV4
    GDV4 --> IDLE
    GF --> IDLE
    GP --> IDLE
    GI3 --> GL["Live form - READ-ONLY"]
    GL --> IDLE

    MENU(("The reader picks<br/>a menu item"))

    subgraph COMMANDS["Four Commands scenes, installed once on the main group"]
        MENU -->|"Game menu"| CM0["GameNavigationCommands - First, Previous,<br/>Next, Last plus Get Info"]
        MENU -->|"Diagnostics menu"| CM1["DiagnosticsCommands - takes the app-global<br/>objects DIRECTLY, because diagnostics are<br/>app-scoped rather than per-tab"]
        MENU -->|"File menu"| CM2["SmartTagCommands - File, New Smart Tag.<br/>The AX-reachable door into the D12′ editor;<br/>the sidebar header's plus is pointer-only"]
        MENU -->|"View menu"| CM3["CollectionViewOptionsCommands - Show View<br/>Options, Cmd-J. The shortcut lives HERE and<br/>nowhere else: it once rode the shared button's<br/>five hosts and registered twice - live and<br/>ambiguous, the worst of the three outcomes.<br/>Enabled only while a collection tab publishes<br/>the subject"]
    end

    CM0 --> CMTRIG["A Commands scene has NO openWindow, any more<br/>than it has a modelContext. So the item<br/>publishes a TRIGGER BINDING and the destination<br/>opens the window - SmartTagCommands' arrangement,<br/>third use"]
    CMTRIG --> ROUTE
    CM2 --> CMTRIG
    CM3 --> CALLID

    CM0 -.-> CMDIS
    CMDIS["The trigger publishes as NIL when the front tab<br/>has no subject, so the item's disabled state is<br/>PRODUCIBLE both ways - the D40′ check applied at<br/>minting rather than at the next sweep"]

    CM1 --> IDLE

    IDLE(("Window open,<br/>waiting on the reader"))

    %% ---- shared class vocabulary: identical block in all five files ----
    classDef act   fill:#e8eef7,stroke:#5b7fb0,color:#12243d
    classDef dec   fill:#fdf0d5,stroke:#c9a227,color:#3d2f04
    classDef bad   fill:#fbe4e4,stroke:#c0504d,color:#4a1210
    classDef note  fill:#efe6f7,stroke:#8064a2,color:#2c1b3d
    classDef drill fill:#e3f2e3,stroke:#4f8a4f,color:#123312
    classDef term  fill:#2f3640,stroke:#1b1f24,color:#ffffff

    class W1,W1A,W2,W2A,W3,W3A,W4,W4A,WQ,WV,G3,G4,G5,G6,D3,D4,D5,Q1,Q2,Q3,Q4,Q5,V1,V4,V6,V7,GI2,GI3,GI4,GD,GM,GMS,GF,GL,GDV3,GDV4,CM0,CM1,CM2,CM3,CMTRIG act
    class ROUTE,G1,D1,V2,V5,GI1,GT,GMV,GDV dec
    class G2,D2,V3,GMR,GDV1,GDV2,GDV5 bad
    class TRAP,AUX,GI3N,GDN,GMN,GSEAT,CMDIS note
    class DEST,GP drill
    class CALL,CALLID,MENU,IDLE term
